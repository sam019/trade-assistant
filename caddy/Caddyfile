# DOMAIN变量在compose文件中配置
http://ta.{$DOMAIN} {
    root * /srv/www
    encode
    file_server

    handle /api/* {
        uri strip_prefix /api
        reverse_proxy server:8080
    }
    
    handle /socket.io/* {
        # Socket.io 升级为 WebSocket 连接时，Caddy 的 reverse_proxy 会自动正确处理
        reverse_proxy server:8080
    }
}

http://{$DOMAIN} {
    respond "Hello, world!"
}