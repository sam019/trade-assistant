{
    "log": {
        "loglevel": "warning"
    },
    "inbounds": [
        {
            "port": 443,
            "protocol": "vless",
            "settings": {
                "clients": [
                    {
                        "id": "__UID__",
                        "flow": "xtls-rprx-vision"
                    }
                ],
                "decryption": "none"
            },
            "streamSettings": {
                "network": "tcp",
                "security": "reality",
                "realitySettings": {
                    "show": false,
                    "dest": "127.0.0.1:8081",
                    "xver": 0,
                    "serverNames": [
                        "__DOMAIN__",
                        "www.__DOMAIN__",
                        "ta.__DOMAIN__"
                    ],
                    "privateKey": "__PRIVATE_KEY__",
                    "shortIds": [__SHORT_ID__]
                }
            }
        }
    ],
    "outbounds": [
        {
            "protocol": "freedom"
        }
    ]
}
